<form method="post" action="{{ path('app_pin_delete', {'id': pin.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce Pin ?');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pin.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>