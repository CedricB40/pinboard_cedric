{% extends 'base.html.twig' %}

{% block title %}Pinboard - Page d'accueil{% endblock %}

{% block body %}
    <div class="text-center py-5 mb-5 bg-light rounded">
        <h1 class="display-5 fw-bold">Épinglez et partagez vos idées</h1>
        <p class="lead text-muted">
            Pinboard vous permet de rassembler, organiser et partager les images qui vous inspirent.
        </p>

        {% if app.user %}
            <a href="{{ path('app_pin_index') }}" class="btn btn-primary btn-lg me-2">Voir les Pins</a>
            <a href="{{ path('app_pin_new') }}" class="btn btn-outline-primary btn-lg">Créer un Pin</a>
        {% else %}
            <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg me-2">S'inscrire</a>
            <a href="{{ path('app_login') }}" class="btn btn-outline-primary btn-lg">Se connecter</a>
        {% endif %}
    </div>

    <h2 class="mb-4">Derniers Pins ajoutés</h2>

    <div class="row">
        {% for pin in recentPins %}
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="card h-100">
                    <a href="{{ path('app_pin_show', {'id': pin.id}) }}">
                        <img src="{{ asset('images/pins/' ~ pin.imageName)|imagine_filter('pin_thumb') }}" class="card-img-top" alt="{{ pin.title }}">
                    </a>
                    <div class="card-body">
                        <h5 class="card-title">
                            <a href="{{ path('app_pin_show', {'id': pin.id}) }}" class="text-decoration-none text-dark">
                                {{ pin.title|u.truncate(30, '...', true) }}
                            </a>
                        </h5>
                        <p class="card-text text-muted small mb-1">
                            Publié {{ pin.createdAt|ago }}
                        </p>
                        <p class="card-text text-muted small">
                            Par {{ pin.user.firstname }} {{ pin.user.lastname }}
                        </p>
                    </div>
                </div>
            </div>
        {% else %}
            <p>Aucun Pin n'a encore été publié.</p>
        {% endfor %}
    </div>

    {% if recentPins|length > 0 %}
        <div class="text-center mt-3">
            <a href="{{ path('app_pin_index') }}" class="btn btn-outline-secondary">Voir tous les Pins</a>
        </div>
    {% endif %}
{% endblock %}